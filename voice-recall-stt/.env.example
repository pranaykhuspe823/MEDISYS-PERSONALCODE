# Copy this file to voice-recall-stt/.env to override defaults.
# Nothing here is a secret — this service needs no API key at all.

# tiny / base / small / medium / large-v3 — bigger = more accurate, slower.
# "small" is the default in service.py if this is left unset — real testing
# found "base" mis-hearing short phrases too often on ordinary laptop mic
# input. Try "medium" if "small" still isn't accurate enough.
WHISPER_MODEL_SIZE=small

# cpu (default) or cuda if this machine has an NVIDIA GPU set up for it.
WHISPER_DEVICE=cpu

# int8 (default, fastest on CPU) / float16 (use with WHISPER_DEVICE=cuda) / float32
WHISPER_COMPUTE_TYPE=int8

PORT=8600
