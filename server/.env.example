DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medisys_h10_city_hospital_ghatkopar
SESSION_SECRET=change-me
PORT=3000

# server/security/encryption.js — encrypts sensitive audit_log fields (e.g.
# stored voice transcripts) at rest. 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Voice patient-recall (POST /api/voice/query, see server/voiceQuery.js).
# STT is a free, self-hosted local Whisper service (voice-recall-stt/,
# started separately — see voice-recall-stt/README.md) — no API key, no
# per-request cost. Defaults to http://127.0.0.1:8600; override only if that
# service runs elsewhere. Deliberately a different service/port from
# VOICE_SERVICE_URL below (Sarvam AI, used only by the unrelated
# voice-*prescription* dictation feature). Without a reachable service,
# VOICE_QUERY_MOCK_TRANSCRIPT is used instead so the rest of the pipeline
# (matching/RBAC/audit/briefing) can still be built and tested. Format the
# heuristic parser expects: "name, complaint".
# VOICE_RECALL_STT_URL=http://127.0.0.1:8600
VOICE_QUERY_MOCK_TRANSCRIPT=Ramesh Kumar, chest pain since yesterday

# ABDM / ABHA integration (see server/abdmService.js + server/abdmProviders/*).
# ABDM_PROVIDER selects which backend actually talks to ABDM:
#   mock    - canned profile data, no network calls (default; safe for dev/demo)
#             OTP is always 111111. A mobile/Aadhaar ending in nine zeros
#             (e.g. 6000000000) simulates "no ABHA found".
#   nha     - calls the NHA ABDM Gateway v3 directly. Free sandbox registration
#             at https://sandbox.abdm.gov.in, then fill in ABDM_CLIENT_ID/SECRET.
#   ekacare - calls Eka Care's Connect API instead (useful while an NHA sandbox
#             approval email is pending). Fill in EKACARE_API_KEY.
# Switching providers is a single env change — no frontend/route code changes.
#
# Fingerprint (Mantra MFS110) registration, specifically, has one more
# requirement beyond ABDM_PROVIDER: the browser at the front desk MUST open
# MEDISYS as http://localhost:<PORT> (or http://127.0.0.1:<PORT>) — not a
# LAN IP, a domain, or a remote desk accessing a centrally-hosted server.
# Fingerprint capture happens in the browser via a direct call to the local
# Mantra RD Service on http://127.0.0.1:11100, which only that same PC can
# reach.
#
# That local call also has to be allowed by this server's own
# Content-Security-Policy connect-src (see the helmet() config below) —
# http://127.0.0.1:11100 is already in that list. If it's ever removed,
# every browser fails identically with a generic "Failed to fetch" and no
# other visible error, which was mistaken for a browser-level Private
# Network Access block for a while before being root-caused via Chrome
# DevTools Protocol inspection on 2026-09-09 (zero network events were
# firing for the RD Service call at all — CSP blocks a disallowed fetch()
# before it becomes a request; a real PNA block would still show the
# request, then fail it). See the in-app checklist under "Fingerprint
# scanner not working?" on the registration/check-in pages for staff-facing
# guidance.
#
# If reception needs to reach a centrally-hosted MEDISYS instead of running
# the server locally, each desk PC would need its own lightweight local
# relay for RD Service calls — that's a real architecture change, not
# something this env file can configure; not solved here.
ABDM_PROVIDER=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_CM_ID=sbx
EKACARE_API_KEY=
EKACARE_BASE_URL=https://api.eka.care

# Telemedicine appointment payment (see server/razorpay.js). Test-mode keys from
# https://dashboard.razorpay.com/app/keys — a patient's telemedicine booking is
# only turned into a real OPD visit (visible to the doctor) after the server
# verifies Razorpay's payment signature with RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
